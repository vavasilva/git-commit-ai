{
  "name": "git-commit-ai",
  "version": "0.2.0",
  "description": "Generate commit messages using local LLMs (Ollama)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "git-commit-ai": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "ollama",
    "llm"
  ],
  "author": "Wagner Alexandre",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "smol-toml": "^1.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
